# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Public application URL
NEXT_PUBLIC_APP_URL=

# Security:
# SUPABASE_SECRET_KEY and OPENAI_API_KEY must never be exposed to the browser.
# Normal user data operations must use the authenticated session and RLS.
